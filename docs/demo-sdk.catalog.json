{
  "version": "0.2.0-alpha",
  "scope": "isolated demo adapters; no authenticated Foundry execution",
  "operations": [
    {
      "id": "demo.redline.attack",
      "version": 1,
      "description": null,
      "mutates": [
        "isolated demo IndexedDB resources",
        "atomic receipt ledger"
      ],
      "permissionDescription": "One isolated browser fixture user, no Foundry rights or game mutations.",
      "argsSchema": {
        "additionalProperties": false,
        "properties": {
          "ammoKey": {
            "type": "string"
          },
          "attackerId": {
            "type": "string"
          },
          "attackerName": {
            "type": "string"
          },
          "dvSource": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "rangeDV": {
            "maximum": 99,
            "minimum": 1,
            "type": "integer"
          },
          "targetId": {
            "type": "string"
          },
          "targetName": {
            "type": "string"
          },
          "weaponId": {
            "type": "string"
          },
          "weaponName": {
            "type": "string"
          }
        },
        "required": [
          "namespace",
          "attackerId",
          "attackerName",
          "targetId",
          "targetName",
          "weaponId",
          "weaponName",
          "rangeDV",
          "dvSource"
        ],
        "type": "object"
      },
      "resultSchema": {
        "properties": {
          "ammoKey": {
            "type": "string"
          },
          "ammoSpent": {
            "const": 1
          },
          "attackTotal": {
            "type": "integer"
          },
          "damage": {
            "type": "integer"
          },
          "dv": {
            "type": "integer"
          },
          "hit": {
            "type": "boolean"
          },
          "targetResourceChanged": {
            "type": "boolean"
          }
        },
        "required": [
          "hit",
          "attackTotal",
          "dv",
          "ammoSpent",
          "ammoKey"
        ],
        "type": "object"
      },
      "supports": {
        "validate": true,
        "permission": true,
        "preview": true,
        "execute": true,
        "reconcile": true,
        "compensate": false
      },
      "idempotentExecution": false,
      "cancellation": "before-execution; during-execution-is-uncertain",
      "cleanup": "AbortSignal supplied to executor; adapter owns resource disposal",
      "decision": {
        "options": [
          "evade",
          "accept"
        ],
        "timeoutMs": 300000
      }
    },
    {
      "id": "journal.choose",
