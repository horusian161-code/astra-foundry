            "type": "string"
          },
          "journalId": {
            "type": "string"
          },
          "openedStageId": {
            "type": "string"
          }
        },
        "required": [
          "journalId",
          "choiceId",
          "openedStageId",
          "alreadyOpen"
        ],
        "type": "object"
      },
      "supports": {
        "validate": true,
        "permission": true,
